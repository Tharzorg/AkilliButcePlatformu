@page
@model ButcePlatformu.Pages.Abonelikler.IndexModel
@{
    ViewData["Title"] = "Abonelikler";
}

<h2 class="mb-3">Düzenli Abonelik Takibi</h2>

<div class="card mb-4 shadow-sm">
    <div class="card-header bg-dark text-white">Yeni Abonelik Ekle</div>
    <div class="card-body">
        <form method="post" asp-page-handler="Ekle">
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="YeniAbonelik.HizmetAdi" class="form-label"></label>
                    <input asp-for="YeniAbonelik.HizmetAdi" class="form-control" placeholder="Örn: Spotify / iCloud" />
                </div>
                <div class="col-md-3">
                    <label asp-for="YeniAbonelik.AylikTutar" class="form-label"></label>
                    <input asp-for="YeniAbonelik.AylikTutar" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-2">
                    <label asp-for="YeniAbonelik.OdemeGunu" class="form-label"></label>
                    <input asp-for="YeniAbonelik.OdemeGunu" class="form-control" type="number" min="1" max="31" />
                </div>
                <div class="col-md-3">
                    <label asp-for="YeniAbonelik.KategoriId" class="form-label"></label>
                    <select asp-for="YeniAbonelik.KategoriId" asp-items="Model.KategoriListesi" class="form-select"></select>
                </div>
            </div>
            <button type="submit" class="btn btn-primary mt-3">Abonelik Ekle</button>
        </form>
    </div>
</div>

<table class="table table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Platform</th>
            <th>Kategori</th>
            <th>Aylık Ücret</th>
            <th>Ödeme Günü</th>
            <th>Durum</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in Model.Abonelikler)
        {
            var kalan = a.KalanGunHesapla();
            <tr>
                <td class="fw-bold">@a.HizmetAdi</td>
                <td>@(a.Kategori?.Ad ?? "Dijital Abonelik")</td>
                <td>@a.AylikTutar.ToString("N2") TL</td>
                <td>Her ayın @a.OdemeGunu. günü</td>
                <td>
                    @if (kalan <= 3)
                    {
                        <span class="badge bg-danger">Yaklaşıyor! (@kalan gün kaldı)</span>
                    }
                    else
                    {
                        <span class="badge bg-success">@kalan gün var</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>